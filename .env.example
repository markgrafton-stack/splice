# Local dev needs none of this — with these unset, Splice runs entirely on a
# local SQLite file (splice-local.sqlite) and public/uploads, so
# `npm install && npm run dev` just works. Set these to point it at the real
# shared team database + storage for a deployed/shared instance.

# Postgres connection string. Vercel: attach a Postgres store to the project
# and this is populated for you automatically.
POSTGRES_URL=

# Vercel Blob read/write token. Vercel: attach a Blob store to the project
# and this is populated for you automatically.
BLOB_READ_WRITE_TOKEN=

# Optional, and only needed if YouTube starts blocking this deployment with
# "Sign in to confirm you're not a bot" (common from datacenter IPs like
# Vercel's — usually not needed for local dev). The full contents of a
# Netscape-format cookies.txt file exported from a browser logged into
# YouTube. Use a throwaway/dedicated Google account for this, not a personal
# one — see the README for the export steps and why. Expires periodically
# and needs re-exporting when it does.
YT_COOKIES=
